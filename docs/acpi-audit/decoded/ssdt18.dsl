                            /* 0058 */  0x00                                             // .
                        })
                    }
                    Case (0x09)
                    {
                        Store ("   NVPCF sub-func#9", Debug)
                        CreateWordField (Arg3, 0x03, CPTD)
                        Divide (CPTD, 0x03E8, , Local1)
                        Store (Local1, \_SB.PC00.LPCB.EC0.DBPL) /* External reference */
                        Return (Zero)
                    }

                }

                Return (0x80000002)
            }
        }
    }

