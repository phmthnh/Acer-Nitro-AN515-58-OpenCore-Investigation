                    If (LEqual (CMSR (0x7C), 0x58))
                    {
                        If (LOr (LEqual (CPTY, 0x07), LEqual (CPTY, 0x09)))
                        {
                            If (LEqual (CMSR (0x77), 0x08))
                            {
                                Return (GSV2) /* \_SB_.PC00.PEG1.PEGP.GSV2 */
                            }
                        }
                    }

                    If (LEqual (CMSR (0x7C), 0x56))
                    {
                        If (LEqual (CPTY, 0x05))
                        {
                            If (LEqual (CMSR (0x77), 0x08))
                            {
                                Return (GSVD) /* \_SB_.PC00.PEG1.PEGP.GSVD */
                            }
                        }
                    }

                    If (LEqual (CMSR (0x7C), 0x56))
