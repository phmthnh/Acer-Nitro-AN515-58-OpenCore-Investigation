                        Return (Buffer (0x59)
                        {
                            /* 0000 */  0x10, 0x04, 0x11, 0x05, 0x64, 0x48, 0x0D, 0x00,  // ....dH..
                            /* 0008 */  0x00, 0x20, 0x4E, 0x00, 0x00, 0x80, 0x3E, 0x00,  // . N...>.
