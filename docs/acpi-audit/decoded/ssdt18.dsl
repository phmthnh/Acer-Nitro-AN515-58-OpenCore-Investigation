                CreateField (BUFF, 0x0400, 0x0400, EDD1)
                Store (IDFD, EDD0) /* \_SB_.PC00.PEG1.PEGP.LCD0._DDC.EDD0 */
                Store (RSR2, EDD1) /* \_SB_.PC00.PEG1.PEGP.LCD0._DDC.EDD1 */
                If (LEqual (Arg0, One))
                {
                    Return (IDFD) /* External reference */
                }

                If (LEqual (Arg0, 0x02))
                {
                    Return (BUFF) /* \_SB_.PC00.PEG1.PEGP.LCD0._DDC.BUFF */
                }

                Return (Zero)
            }

            Method (MXDS, 1, NotSerialized)
            {
                Store (Arg0, Local0)
                And (Local0, 0x0F, Local1)
                And (Local0, 0x10, Local2)
                If (LEqual (Local1, Zero))
                {
                    If (LEqual (\_SB.PC00.LPCB.EC0.EDPW, Zero))
                    {
                        Return (One)
                    }
                    Else
                    {
                        Return (0x02)
                    }
                }
                ElseIf (LEqual (Local1, One))
                {
                    If (LEqual (Local2, 0x10))
                    {
                        Store (One, \_SB.PC00.LPCB.EC0.EDPW) /* External reference */
                    }
                    Else
                    {
                        Store (Zero, \_SB.PC00.LPCB.EC0.EDPW) /* External reference */
                    }

                    Return (One)
                }
                Else
                {
                    Return (Zero)
                }
            }

            Method (MXDM, 1, NotSerialized)
            {
                Store (Arg0, Local0)
                And (Local0, 0x07, Local1)
                If (LEqual (Local1, Zero))
                {
                    Store (DISM, Local2)
                    Return (Local2)
                }
                ElseIf (LLess (Local1, 0x05))
                {
                    Store (DISM, Local2)
                    Store (Local1, DISM) /* \_SB_.PC00.DISM */
                    Or (Local1, 0x10, Local1)
                    Store (0x7C, IOB2) /* \_SB_.PC00.PEG1.PEGP.IOB2 */
                    CMSW (0x73, Local1)
                    Store (Local2, DISM) /* \_SB_.PC00.DISM */
                }
                Else
                {
                    Return (Zero)
                }

                Return (One)
            }

            Method (MXID, 1, NotSerialized)
            {
                If (LEqual (Arg0, Zero))
                {
                    Store (DerefOf (Index (DerefOf (Index (MMID, Zero)), 0x02)), Local0)
                    Return (Local0)
                }
            }

            Method (LRST, 1, NotSerialized)
            {
                Store (Arg0, Local0)
                And (Local0, 0x07, Local1)
                If (LEqual (Local1, Zero))
                {
                    If (LEqual (\_SB.PC00.LPCB.EC0.LCDR, Zero))
                    {
                        Return (One)
                    }
                    ElseIf (LEqual (\_SB.PC00.LPCB.EC0.LCDR, One))
                    {
                        Return (0x02)
                    }
                    Else
                    {
                        Return (Zero)
                    }
                }
                ElseIf (LEqual (Local1, One))
                {
                    Store (Zero, \_SB.PC00.LPCB.EC0.LCDR) /* External reference */
                }
                ElseIf (LEqual (Local1, 0x02))
                {
                    Store (One, \_SB.PC00.LPCB.EC0.LCDR) /* External reference */
                }
                Else
                {
                    Return (Zero)
                }
            }
        }
    }

    Scope (\_SB.PC00)
    {
        Device (AWMI)
        {
            Name (_HID, "PNP0C14" /* Windows Management Instrumentation Device */)  // _HID: Hardware ID
            Name (_UID, "0x00")  // _UID: Unique ID
            Name (_WDG, Buffer (0x28)
            {
                /* 0000 */  0x13, 0x96, 0x3E, 0x60, 0x25, 0xEF, 0x38, 0x43,  // ..>`%.8C
                /* 0008 */  0xA3, 0xD0, 0xC4, 0x61, 0x77, 0x51, 0x6D, 0xB7,  // ...awQm.
                /* 0010 */  0x41, 0x41, 0x01, 0x02, 0x21, 0x12, 0x90, 0x05,  // AA..!...
                /* 0018 */  0x66, 0xD5, 0xD1, 0x11, 0xB2, 0xF0, 0x00, 0xA0,  // f.......
                /* 0020 */  0xC9, 0x06, 0x29, 0x10, 0x30, 0x30, 0x01, 0x00   // ..).00..
            })
            Method (WMAA, 3, Serialized)
            {
                Name (TEMP, Zero)
                CreateByteField (Arg2, Zero, MODF)
                CreateDWordField (Arg2, 0x04, LEDB)
                While (One)
                {
                    Store (Arg1, TEMP) /* \_SB_.PC00.AWMI.WMAA.TEMP */
                    If (LEqual (TEMP, One))
                    {
                        If (LEqual (MODF, Zero))
                        {
                            Return (\_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                        }
                        ElseIf (LEqual (MODF, One))
                        {
                            Switch (ToInteger (LEDB))
                            {
                                Case (0x0D)
                                {
                                    Store (0x10, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0x1A)
                                {
                                    Store (0x2E, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0x27)
                                {
                                    Store (0x4D, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0x33)
                                {
                                    Store (0x5E, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0x40)
                                {
                                    Store (0x73, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0x4D)
                                {
                                    Store (0x89, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0x61)
                                {
                                    Store (0x9D, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0x80)
                                {
                                    Store (0xB2, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xA1)
                                {
                                    Store (0xC7, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xA5)
                                {
                                    Store (0xC9, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xA9)
                                {
                                    Store (0xCB, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xAD)
                                {
                                    Store (0xCE, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xB2)
                                {
                                    Store (0xCF, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xB6)
                                {
                                    Store (0xD1, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xBA)
                                {
                                    Store (0xD3, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xBF)
                                {
                                    Store (0xD5, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
