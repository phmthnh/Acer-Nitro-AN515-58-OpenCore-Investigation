                        {
                            If (LEqual (CMSR (0x77), 0x08))
                            {
                                Return (GS3A) /* \_SB_.PC00.PEG1.PEGP.GS3A */
                            }
                        }
                    }

                    If (LEqual (CMSR (0x7C), 0x61))
                    {
                        If (LEqual (CPTY, 0x05))
                        {
                            If (LEqual (CMSR (0x77), 0x08))
                            {
                                Return (GS3B) /* \_SB_.PC00.PEG1.PEGP.GS3B */
                            }
                        }
