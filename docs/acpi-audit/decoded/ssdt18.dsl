                        Switch (CMSR (0x77))
                        {
                            Case (0x12)
                            {
                                Return (Buffer (0x38)
                                {
                                    /* 0000 */  0x11, 0x04, 0x34, 0x01, 0x05, 0x00, 0x01, 0x02,  // ..4.....
                                    /* 0008 */  0x03, 0x04, 0x03, 0x00, 0x01, 0x02, 0x00, 0x00,  // ........
                                    /* 0010 */  0x00, 0x01, 0x02, 0x03, 0x00, 0x00, 0x00, 0x01,  // ........
                                    /* 0018 */  0x02, 0x03, 0x00, 0x00, 0x00, 0x01, 0x02, 0x03,  // ........
                                    /* 0020 */  0x00, 0x01, 0x01, 0x01, 0x02, 0x03, 0x01, 0x01,  // ........
                                    /* 0028 */  0x01, 0x01, 0x02, 0x03, 0x02, 0x02, 0x02, 0x02,  // ........
                                    /* 0030 */  0x02, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03   // ........
                                })
                            }
                            Default
                            {
