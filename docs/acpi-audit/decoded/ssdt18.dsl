                                Case (0xC3)
                                {
                                    Store (0xD6, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xC7)
                                {
                                    Store (0xD7, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xD1)
                                {
                                    Store (0xD9, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xD6)
                                {
                                    Store (0xDA, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Case (0xCC)
                                {
                                    Store (0xDB, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    Break
                                }
                                Default
                                {
                                    If (LAnd (LGreater (LEDB, 0x0D), LLess (LEDB, 0x1A)))
                                    {
                                        Add (0x07, LEDB, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    }
                                    ElseIf (LAnd (LGreater (LEDB, 0x1A), LLess (LEDB, 0x27)))
                                    {
                                        Add (0x14, LEDB, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    }
                                    ElseIf (LAnd (LGreater (LEDB, 0x27), LLess (LEDB, 0x33)))
                                    {
                                        Add (0x26, LEDB, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    }
                                    ElseIf (LAnd (LGreater (LEDB, 0x33), LLess (LEDB, 0x40)))
                                    {
                                        Add (0x2B, LEDB, \_SB.PC00.LPCB.EC0.PWMB) /* External reference */
                                    }
                                    ElseIf (LAnd (LGreater (LEDB, 0x40), LLess (LEDB, 0x4D)))
                                    {
