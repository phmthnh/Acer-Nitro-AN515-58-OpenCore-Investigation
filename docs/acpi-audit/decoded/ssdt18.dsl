    OperationRegion (XCMS, SystemIO, 0x72, 0x02)
    Field (XCMS, ByteAcc, NoLock, Preserve)
    {
        CMSI,   8, 
        CMSD,   8
    }

    Method (CMSW, 2, NotSerialized)
    {
        Store (Arg0, CMSI) /* \CMSI */
        Store (Arg1, CMSD) /* \CMSD */
    }

    Method (CMSR, 1, NotSerialized)
    {
        Store (Arg0, CMSI) /* \CMSI */
        Return (CMSD) /* \CMSD */
    }

    Scope (\_SB)
    {
        Device (NPCF)
        {
            Name (ACBT, 0x50)
            Name (DCBT, Zero)
            Name (DBAC, Zero)
            Name (DBDC, One)
            Name (AMAT, 0x78)
            Name (AMIT, Zero)
            Name (ATPP, 0x0168)
            Name (DTPP, Zero)
            Name (IOBS, 0x025D)
            Name (CMPL, 0x29)
            Name (CNPL, 0x1F)
            Name (HPCT, 0x02)
            Name (CDIS, Zero)
            Name (CUSL, Zero)
            Name (CUCT, Zero)
            Name (PID1, Zero)
            Name (PID2, Zero)
            Name (PID3, Zero)
            Method (_HID, 0, NotSerialized)  // _HID: Hardware ID
            {
                Store (Zero, CDIS) /* \_SB_.NPCF.CDIS */
                Return ("NVDA0820")
            }

            Name (_UID, "NPCF")  // _UID: Unique ID
            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                If (LEqual (CDIS, One))
                {
                    Return (0x0D)
                }

                Return (0x0F)
            }

            Method (_DIS, 0, NotSerialized)  // _DIS: Disable Device
            {
                Store (One, CDIS) /* \_SB_.NPCF.CDIS */
            }

            Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
            {
                If (LEqual (Arg0, ToUUID ("36b49710-2483-11e7-9598-0800200c9a66") /* Unknown UUID */))
                {
                    If (LNotEqual (\_SB.PC00.PEG1.PEGP.NPCS, Zero))
                    {
                        Return (NPCF (Arg0, Arg1, Arg2, Arg3))
                    }
                }
            }

            Method (NPCF, 4, Serialized)
            {
                Store ("------- NVPCF DSM --------", Debug)
                If (LNotEqual (ToInteger (Arg1), 0x0200))
                {
                    Return (0x80000001)
                }

                Switch (ToInteger (Arg2))
                {
                    Case (Zero)
                    {
                        Store ("   NVPCF sub-func#0", Debug)
                        Return (Buffer (0x04)
                        {
                             0xFF, 0x03, 0x00, 0x00                           // ....
                        })
                    }
                    Case (One)
                    {
                        Store ("   NVPCF sub-func#1", Debug)
                        Return (Buffer (0x0E)
                        {
                            /* 0000 */  0x20, 0x03, 0x01, 0x00, 0x22, 0x04, 0x05, 0x01,  //  ..."...
                            /* 0008 */  0x01, 0x01, 0x00, 0x00, 0x00, 0xAE               // ......
                        })
                    }
                    Case (0x02)
                    {
                        Store ("   NVPCF sub-func#2", Debug)
                        Name (PBD2, Buffer (0x31)
                        {
                             0x00                                             // .
                        })
                        CreateByteField (PBD2, Zero, PTV2)
                        CreateByteField (PBD2, One, PHB2)
                        CreateByteField (PBD2, 0x02, GSB2)
                        CreateByteField (PBD2, 0x03, CTB2)
                        CreateByteField (PBD2, 0x04, NCE2)
                        Store (0x22, PTV2) /* \_SB_.NPCF.NPCF.PTV2 */
                        Store (0x05, PHB2) /* \_SB_.NPCF.NPCF.PHB2 */
                        Store (0x10, GSB2) /* \_SB_.NPCF.NPCF.GSB2 */
                        Store (0x1C, CTB2) /* \_SB_.NPCF.NPCF.CTB2 */
                        Store (One, NCE2) /* \_SB_.NPCF.NPCF.NCE2 */
                        CreateWordField (PBD2, 0x05, TGPA)
                        CreateWordField (PBD2, 0x07, TGPD)
                        CreateByteField (PBD2, 0x15, PC01)
                        CreateByteField (PBD2, 0x16, PC02)
                        CreateWordField (PBD2, 0x19, TPPA)
                        CreateWordField (PBD2, 0x1B, TPPD)
                        CreateWordField (PBD2, 0x1D, MAGA)
                        CreateWordField (PBD2, 0x1F, MAGD)
                        CreateWordField (PBD2, 0x21, MIGA)
                        CreateWordField (PBD2, 0x23, MIGD)
                        CreateDWordField (PBD2, 0x25, PA4O)
                        CreateDWordField (PBD2, 0x29, PA5O)
                        CreateDWordField (PBD2, 0x2D, PA6O)
                        CreateField (Arg3, 0x28, 0x02, NIGS)
                        CreateByteField (Arg3, 0x15, IORC)
                        CreateField (Arg3, 0xB0, One, PWCS)
                        CreateField (Arg3, 0xB1, One, PWTS)
                        CreateField (Arg3, 0xB2, One, CGPS)
                        If (LEqual (ToInteger (NIGS), Zero))
                        {
                            If (LEqual (CMSR (0x77), 0x03))
                            {
                                Store (0xC8, AMAT) /* \_SB_.NPCF.AMAT */
                            }
                            ElseIf (LEqual (CMSR (0x77), 0x04))
                            {
                                Store (0xC8, AMAT) /* \_SB_.NPCF.AMAT */
                            }
                            ElseIf (LEqual (CMSR (0x77), 0x05))
                            {
                                Store (0xC8, AMAT) /* \_SB_.NPCF.AMAT */
                            }
                            ElseIf (LEqual (CMSR (0x77), 0x08))
                            {
                                Store (0xC8, AMAT) /* \_SB_.NPCF.AMAT */
                            }
                            ElseIf (LEqual (CMSR (0x77), 0x09))
                            {
                                Store (0xC8, AMAT) /* \_SB_.NPCF.AMAT */
                            }
                            ElseIf (LEqual (CMSR (0x77), 0x0A))
                            {
                                Store (0xC8, AMAT) /* \_SB_.NPCF.AMAT */
                            }
                            Else
                            {
                                Store (0x78, AMAT) /* \_SB_.NPCF.AMAT */
                            }

                            If (LEqual (\_SB.PC00.LPCB.EC0.QBMD, One))
                            {
                                Store (One, DBAC) /* \_SB_.NPCF.DBAC */
                            }
                            Else
                            {
                                Store (Zero, DBAC) /* \_SB_.NPCF.DBAC */
                            }

                            If (LEqual (\_SB.PC00.LPCB.EC0.OPMS, Zero))
                            {
                                Store (0x0118, ATPP) /* \_SB_.NPCF.ATPP */
                                Store (Zero, ACBT) /* \_SB_.NPCF.ACBT */
                            }
                            ElseIf (LEqual (\_SB.PC00.LPCB.EC0.OPMS, One))
                            {
                                Store (0x0168, ATPP) /* \_SB_.NPCF.ATPP */
                                Store (Zero, ACBT) /* \_SB_.NPCF.ACBT */
                            }
                            ElseIf (LEqual (\_SB.PC00.LPCB.EC0.OPMS, 0x04))
                            {
                                Store (0x0168, ATPP) /* \_SB_.NPCF.ATPP */
                                If (LEqual (CMSR (0x77), 0x03))
                                {
                                    Store (0x0118, ACBT) /* \_SB_.NPCF.ACBT */
                                }
                                ElseIf (LEqual (CMSR (0x77), 0x05))
                                {
                                    Store (0x50, ACBT) /* \_SB_.NPCF.ACBT */
                                    Store (0x01B8, ATPP) /* \_SB_.NPCF.ATPP */
                                }
                                ElseIf (LEqual (CMSR (0x77), 0x04))
                                {
                                    Store (0x50, ACBT) /* \_SB_.NPCF.ACBT */
                                    Store (0x01B8, ATPP) /* \_SB_.NPCF.ATPP */
                                }
                                ElseIf (LEqual (CMSR (0x77), 0x08))
                                {
                                    Store (0x0118, ACBT) /* \_SB_.NPCF.ACBT */
                                }
                                ElseIf (LEqual (CMSR (0x77), 0x09))
                                {
                                    Store (0x50, ACBT) /* \_SB_.NPCF.ACBT */
                                    Store (0x01B8, ATPP) /* \_SB_.NPCF.ATPP */
                                }
                                ElseIf (LEqual (CMSR (0x77), 0x0A))
                                {
                                    Store (0x50, ACBT) /* \_SB_.NPCF.ACBT */
                                    Store (0x01B8, ATPP) /* \_SB_.NPCF.ATPP */
                                }
                                ElseIf (LEqual (CMSR (0x77), 0x12))
                                {
                                    Store (0x50, ACBT) /* \_SB_.NPCF.ACBT */
                                }
                                Else
                                {
                                    Store (0xA0, ACBT) /* \_SB_.NPCF.ACBT */
                                }
                            }

                            Store (ACBT, TGPA) /* \_SB_.NPCF.NPCF.TGPA */
                            Store (DCBT, TGPD) /* \_SB_.NPCF.NPCF.TGPD */
                            Store (Zero, PC01) /* \_SB_.NPCF.NPCF.PC01 */
                            Or (DBAC, ShiftLeft (DBDC, One), PC02) /* \_SB_.NPCF.NPCF.PC02 */
                            Store (ATPP, TPPA) /* \_SB_.NPCF.NPCF.TPPA */
                            Store (DTPP, TPPD) /* \_SB_.NPCF.NPCF.TPPD */
                            Store (AMAT, MAGA) /* \_SB_.NPCF.NPCF.MAGA */
                            Store (AMIT, MIGA) /* \_SB_.NPCF.NPCF.MIGA */
                        }

                        If (LEqual (ToInteger (NIGS), One))
                        {
                            If (LEqual (ToInteger (PWCS), One)){}
                            Else
                            {
                            }

                            If (LEqual (ToInteger (PWTS), One)){}
                            Else
                            {
                            }

                            If (LEqual (ToInteger (CGPS), One)){}
                            Else
                            {
                            }

                            Store (Zero, TGPA) /* \_SB_.NPCF.NPCF.TGPA */
                            Store (Zero, TGPD) /* \_SB_.NPCF.NPCF.TGPD */
                            Store (Zero, PC01) /* \_SB_.NPCF.NPCF.PC01 */
                            Store (Zero, PC02) /* \_SB_.NPCF.NPCF.PC02 */
                            Store (Zero, TPPA) /* \_SB_.NPCF.NPCF.TPPA */
                            Store (Zero, TPPD) /* \_SB_.NPCF.NPCF.TPPD */
                            Store (Zero, MAGA) /* \_SB_.NPCF.NPCF.MAGA */
                            Store (Zero, MIGA) /* \_SB_.NPCF.NPCF.MIGA */
                            Store (Zero, MAGD) /* \_SB_.NPCF.NPCF.MAGD */
                            Store (Zero, MIGD) /* \_SB_.NPCF.NPCF.MIGD */
                        }

                        Return (PBD2) /* \_SB_.NPCF.NPCF.PBD2 */
                    }
                    Case (0x03)
                    {
                        Store ("   NVPCF sub-func#3", Debug)
                        Switch (CMSR (0x77))
                        {
                            Case (0x12)
                            {
                                Return (Buffer (0x3D)
                                {
                                    /* 0000 */  0x11, 0x04, 0x13, 0x03, 0x00, 0xFF, 0x00, 0x32,  // .......2
                                    /* 0008 */  0x38, 0x36, 0x40, 0x39, 0x43, 0x41, 0x47, 0x43,  // 86@9CAGC
                                    /* 0010 */  0x4D, 0x45, 0x5C, 0xFF, 0xFF, 0xFF, 0xFF, 0x05,  // ME\.....
                                    /* 0018 */  0xFF, 0x00, 0x32, 0x3A, 0x37, 0x41, 0x3D, 0x48,  // ..2:7A=H
                                    /* 0020 */  0x40, 0x4E, 0x44, 0x55, 0xFF, 0xFF, 0xFF, 0xFF,  // @NDU....
                                    /* 0028 */  0xFF, 0xFF, 0x02, 0xFF, 0x00, 0x28, 0x37, 0x32,  // .....(72
                                    /* 0030 */  0x3A, 0x37, 0x3C, 0x41, 0x46, 0x46, 0x4B, 0x4B,  // :7<AFFKK
                                    /* 0038 */  0x50, 0xFF, 0xFF, 0xFF, 0xFF                     // P....
                                })
                            }
                            Default
                            {
