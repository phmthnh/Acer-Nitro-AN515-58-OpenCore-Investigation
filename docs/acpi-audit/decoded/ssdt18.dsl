            If (LEqual (Arg2, 0x10))
            {
                Store ("   NBCI fun16 NBCI_FUNC_GETOBJBYTYPE", Debug)
                CreateWordField (Arg3, 0x02, BFF0)
                If (LEqual (BFF0, 0x564B))
