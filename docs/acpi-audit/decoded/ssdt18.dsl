                                {
                                    /* 0000 */  0x11, 0x04, 0x13, 0x03, 0x00, 0xFF, 0x00, 0x23,  // .......#
                                    /* 0008 */  0x2D, 0x28, 0x32, 0x2D, 0x37, 0x32, 0x3C, 0x37,  // -(2-72<7
                                    /* 0010 */  0x41, 0x3C, 0x46, 0x41, 0x4B, 0xFF, 0xFF, 0x05,  // A<FAK...
                                    /* 0018 */  0xFF, 0x00, 0x3C, 0x46, 0x41, 0x4B, 0xFF, 0xFF,  // ..<FAK..
                                    /* 0020 */  0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,  // ........
                                    /* 0028 */  0xFF, 0xFF, 0x02, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,  // ........
                                    /* 0030 */  0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,  // ........
                                    /* 0038 */  0x00, 0x28, 0x2E, 0x2B, 0x32                     // .(.+2
                                })
                            }

